<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 设置分组标题菱形点 -->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="45"
    android:toDegrees="45"
    android:pivotX="50%"
    android:pivotY="50%">
    <shape android:shape="rectangle">
        <solid android:color="@color/md_amber" />
        <size
            android:width="7dp"
            android:height="7dp" />
    </shape>
</rotate>
