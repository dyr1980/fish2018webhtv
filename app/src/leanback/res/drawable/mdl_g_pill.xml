<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 胶囊条目/圆钮：焦点琥珀淡染描边，普通面板亮阶细描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_amber_12" />
            <stroke android:width="2dp" android:color="@color/md_amber" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_amber_12" />
            <stroke android:width="2dp" android:color="@color/md_amber" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_amber_12" />
            <stroke android:width="1dp" android:color="@color/md_amber_deep" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel_2" />
            <stroke android:width="1dp" android:color="@color/md_line_2" />
            <corners android:radius="999dp" />
        </shape>
    </item>

</selector>
