<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 琥珀菱形装饰：5dp 方块旋转 45° -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="45">
            <shape android:shape="rectangle">
                <size
                    android:width="5dp"
                    android:height="5dp" />
                <solid android:color="@color/md_amber" />
            </shape>
        </rotate>
    </item>
</layer-list>
