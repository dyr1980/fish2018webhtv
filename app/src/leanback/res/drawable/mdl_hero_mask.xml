<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 电视端首页 Hero 遮罩：左向渐隐 + 底部渐隐，保证左侧信息可读 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/md_ink"
                android:centerColor="#B00B0D13"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/md_ink"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
