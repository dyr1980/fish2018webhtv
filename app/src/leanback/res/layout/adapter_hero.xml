<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 电视端首页 Hero 推荐位：剧照 + 左侧信息 + OK 立即播放 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="340dp"
    android:background="@color/md_panel_2"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/selector_video">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@color/md_panel" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/mdl_hero_mask"
        android:importantForAccessibility="no" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="40dp"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.28"
            android:singleLine="true"
            android:text="今日推荐"
            android:textColor="@color/md_amber"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/noto_serif_sc_bold"
            android:letterSpacing="0.08"
            android:maxWidth="760dp"
            android:shadowColor="#A6000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="18"
            android:singleLine="true"
            android:textColor="@color/md_paper"
            android:textSize="46sp"
            android:textStyle="bold"
            tools:text="深空回响" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxWidth="760dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/md_mist"
            android:textSize="16sp"
            tools:text="2026 · 科幻 · 全 10 集" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="2"
            android:maxWidth="700dp"
            android:textColor="@color/md_mist"
            android:textSize="14sp"
            tools:text="人类第一艘深空方舟失联三十年后，一段以已灭绝语言编码的信号从猎户臂传回。" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mdl_v_seal_amber"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="OK"
                android:textColor="@color/md_on_amber"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="立即播放"
                android:textColor="@color/md_mist"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
