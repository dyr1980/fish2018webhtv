<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · chip 文字：激活态琥珀，普通雾蓝，禁用三级雾蓝 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/md_amber" android:state_activated="true" />
    <item android:color="@color/md_amber" android:state_checked="true" />
    <item android:color="@color/md_amber" android:state_selected="true" />
    <item android:color="@color/md_mist_dim" android:state_enabled="false" />
    <item android:color="@color/md_mist" />
</selector>
