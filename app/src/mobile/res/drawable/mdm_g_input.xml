<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 输入框底：面板亮阶 + md_line_2 描边，聚焦转琥珀 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel_2" />
            <stroke
                android:width="1dp"
                android:color="@color/md_amber" />
            <corners android:radius="12dp" />
            <padding
                android:bottom="10dp"
                android:left="14dp"
                android:right="14dp"
                android:top="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel_2" />
            <stroke
                android:width="1dp"
                android:color="@color/md_line_2" />
            <corners android:radius="12dp" />
            <padding
                android:bottom="10dp"
                android:left="14dp"
                android:right="14dp"
                android:top="10dp" />
        </shape>
    </item>
</selector>
