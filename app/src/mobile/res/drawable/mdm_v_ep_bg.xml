<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 选集底：普通集幕布深卡片，当前集琥珀实底 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_amber_glow">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/md_amber" />
                    <stroke android:width="1dp" android:color="@color/md_amber" />
                </shape>
            </item>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/md_amber" />
                    <stroke android:width="1dp" android:color="@color/md_amber" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/md_amber" />
                    <stroke android:width="1dp" android:color="@color/md_amber" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/md_panel_2" />
                    <stroke android:width="1dp" android:color="@color/md_line_2" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/md_panel" />
                    <stroke android:width="1dp" android:color="@color/md_line" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
