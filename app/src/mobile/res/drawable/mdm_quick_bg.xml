<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 快搜结果卡底：幕布深面板 + 细描边 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_amber_12">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mdm_quick_item" />
            <stroke
                android:width="1dp"
                android:color="@color/md_line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_paper" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
