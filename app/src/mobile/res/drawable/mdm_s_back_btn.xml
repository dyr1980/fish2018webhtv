<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 36dp 圆形返回钮：幕布深底 + 细描边 + 暖白箭头 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="36dp"
        android:height="36dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/md_panel" />
            <stroke
                android:width="1dp"
                android:color="@color/md_line_2" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/mdm_s_ic_back"
        android:gravity="center" />
</layer-list>
