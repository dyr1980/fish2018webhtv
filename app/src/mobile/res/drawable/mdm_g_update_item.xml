<?xml version="1.0" encoding="utf-8"?>
<!-- 午夜首映 · 更新弹窗版本卡：暗色面板，聚焦琥珀描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel_2" />
            <stroke
                android:width="2dp"
                android:color="@color/md_amber" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel_2" />
            <stroke
                android:width="1dp"
                android:color="@color/md_line_2" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_panel" />
            <stroke
                android:width="1dp"
                android:color="@color/md_line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
